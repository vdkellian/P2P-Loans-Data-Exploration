      <column caption='Loan_Amnt / Annual Inc' datatype='real' name='[Calculation_0152610248224768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[loan_amnt]/[annual_inc]' />
      </column>
      <column caption='Last Pymnt Amnt/Annual Inc' datatype='real' name='[Calculation_0152610254135297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[last_pymnt_amnt]/[annual_inc]' />
      </column>
      <column caption='Income bin' datatype='string' name='[Calculation_0704497311358979]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [annual_inc]&gt;=100000 then &quot;100k+&quot;&#10;ELSE&#10;STR(&#10;INT([annual_inc]/5000)*5000)&#10;+ &quot;-&quot;&#10;+&#10;STR(&#10;INT([annual_inc]/5000)*5000+4999)&#10;&#10;END' />
      </column>
      <column caption='Calculation5' datatype='real' name='[Calculation_0704497339379720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([annual_inc])' />
      </column>
      <column caption='Median Annual Inc' datatype='real' name='[Calculation_0704497339936777]' role='measure' type='quantitative'>
