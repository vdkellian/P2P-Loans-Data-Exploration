      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id]) / TOTAL(COUNT([id]))'>
          <table-calc ordering-type='Field'>
            <order field='[federated.0wkuaw51l7vfmb18e3vws1rjvefw].[none:grade:nk]' />
            <order field='[federated.0wkuaw51l7vfmb18e3vws1rjvefw].[none:sub_grade:nk]' />
          </table-calc>
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([term]) / TOTAL(COUNT([term]))'>
          <table-calc ordering-field='[federated.0wkuaw51l7vfmb18e3vws1rjvefw].[none:term:nk]' ordering-type='Field' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([emp_title]) / TOTAL(COUNT([emp_title]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation4]' role='measure' type='quantitative'>
